# Copia este archivo a ".env" y ajusta los valores antes de arrancar en produccion.

# Puerto donde corre el servidor.
PORT=3000

# Zona horaria de la barberia. Es importante para que la disponibilidad de horas
# y el "hoy" del panel coincidan con la hora real del local.
TZ=America/Bogota

# Clave secreta usada para firmar las sesiones del panel del barbero.
# Cambiala por una cadena larga y aleatoria antes de publicar la app.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Contrasena inicial del panel del barbero. Solo se usa la PRIMERA vez que
# arranca el servidor (para crear la cuenta). Despues se cambia desde
# el panel, en la pestana "Ajustes", y este valor deja de tener efecto.
ADMIN_INITIAL_PASSWORD=cambiame123

# Notificaciones por correo cuando un cliente agenda una cita.
# API key de Resend (https://resend.com) - se genera gratis en el dashboard,
# seccion "API Keys". Mientras este vacio, la app simplemente no envia el correo.
RESEND_API_KEY=
# Correo del barbero que debe recibir la notificacion de cada cita nueva.
NOTIFY_EMAIL=
# Remitente del correo. Con cuenta gratuita de Resend (sin dominio propio
# verificado) deja este valor tal cual.
MAIL_FROM=onboarding@resend.dev
